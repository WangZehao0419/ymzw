<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiAgentMapper">

    <!-- 实体结果映射 -->
    <resultMap id="AiAgentResultMap" type="com.ruoyi.ai.entity.AiAgent">
        <id property="id" column="id"/>
        <result property="agentName" column="agent_name"/>
        <result property="agentType" column="agent_type"/>
        <result property="agentAvatar" column="agent_avatar"/>
        <result property="systemPrompt" column="system_prompt"/>
        <result property="apiEndpoint" column="api_endpoint"/>
        <result property="apiKey" column="api_key"/>
        <result property="modelIdentifier" column="model_identifier"/>
        <result property="temperature" column="temperature"/>
        <result property="toolsConfig" column="tools_config"/>
        <result property="knowledgeBaseIds" column="knowledge_base_ids"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateUser" column="update_user"/>
        <result property="deleteFlag" column="delete_flag"/>
    </resultMap>

    <!-- VO结果映射 -->
    <resultMap id="AiAgentVOResultMap" type="com.ruoyi.ai.entity.vo.AiAgentVO">
        <id property="id" column="id"/>
        <result property="agentName" column="agent_name"/>
        <result property="agentType" column="agent_type"/>
        <result property="agentAvatar" column="agent_avatar"/>
        <result property="systemPrompt" column="system_prompt"/>
        <result property="apiEndpoint" column="api_endpoint"/>
        <result property="apiKey" column="api_key"/>
        <result property="modelIdentifier" column="model_identifier"/>
        <result property="temperature" column="temperature"/>
        <result property="toolsConfig" column="tools_config"/>
        <result property="knowledgeBaseIds" column="knowledge_base_ids"/>
        <result property="description" column="description"/>
        <result property="status" column="status"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createUser" column="create_user"/>
        <result property="updateUser" column="update_user"/>
    </resultMap>

    <!-- 分页查询智能体列表 -->
    <select id="selectAgentPage" resultMap="AiAgentVOResultMap">
        SELECT 
            id, agent_name, agent_type, agent_avatar, system_prompt,
            api_endpoint, api_key, model_identifier, temperature,
            tools_config, knowledge_base_ids,
            description, status, sort_order, remark,
            create_time, update_time, create_user, update_user
        FROM ai_agent
        WHERE delete_flag = 0
        <if test="query.agentName != null and query.agentName != ''">
            AND agent_name LIKE CONCAT('%', #{query.agentName}, '%')
        </if>
        <if test="query.agentType != null and query.agentType != ''">
            AND agent_type = #{query.agentType}
        </if>
        <if test="query.status != null">
            AND status = #{query.status}
        </if>
        ORDER BY sort_order ASC, create_time DESC
    </select>

    <!-- 根据ID查询智能体详情 -->
    <select id="selectAgentById" resultMap="AiAgentVOResultMap">
        SELECT 
            id, agent_name, agent_type, agent_avatar, system_prompt,
            api_endpoint, api_key, model_identifier, temperature,
            tools_config, knowledge_base_ids,
            description, status, sort_order, remark,
            create_time, update_time, create_user, update_user
        FROM ai_agent
        WHERE id = #{id} AND delete_flag = 0
    </select>

    <!-- 检查智能体名称是否唯一 -->
    <select id="countByAgentName" resultType="int">
        SELECT COUNT(*)
        FROM ai_agent
        WHERE delete_flag = 0 AND agent_name = #{agentName}
        <if test="excludeId != null">
            AND id != #{excludeId}
        </if>
    </select>

    </mapper>